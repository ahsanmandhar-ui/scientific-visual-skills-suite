{
  "template_id": "clinical-research",
  "name": "Clinical Trial & Observational Cohort Poster",
  "description": "High-clarity clinical research template engineered for ACC, ASN, AHA, BMJ, and hospital clinical congresses. Integrates patient flow, primary clinical endpoint callout, survival/outcome visualization, baseline/subgroup tables, and bedside implications.",
  "reporting_standard": "CONSORT / STROBE / STARD",
  "default_dimensions": "48x36",
  "default_layout_recipe": "clinical_workflow",
  "portrait_layout_recipe": "two_column_editorial",
  "default_palette": "academic_navy",
  "default_font_pairing": "clinical_precision",
  "masthead_style": "solid_banner",
  "section_numbering": true,
  "word_budget_target": 520,
  "recommended_charts": ["kaplan_meier", "consort_diagram", "flow_diagram", "bar_chart", "roc_curve", "characteristics_table", "statistical_table"],
  "section_blueprint": [
    {"id": "background", "title": "Clinical Background & Rationale", "column_hint": 0, "style": "editorial_rule", "essential": true},
    {"id": "objectives", "title": "Study Objectives", "column_hint": 0, "style": "editorial_rule", "essential": true},
    {"id": "methods", "title": "Study Design, Population & Methods", "column_hint": 0, "style": "editorial_rule", "essential": true},
    {"id": "primary_outcome", "title": "Primary Clinical Endpoint", "column_hint": 1, "style": "focal_callout", "essential": true},
    {"id": "primary_figure", "title": "Primary Outcome Visualization", "column_hint": 1, "style": "figure_well", "essential": true},
    {"id": "secondary_table_or_figure", "title": "Baseline Characteristics & Subgroup Outcomes", "column_hint": 1, "style": "booktabs_table", "essential": false},
    {"id": "secondary_outcomes", "title": "Secondary & Safety Outcomes", "column_hint": 2, "style": "editorial_rule", "essential": false},
    {"id": "limitations", "title": "Strengths & Limitations", "column_hint": 2, "style": "editorial_rule", "essential": true},
    {"id": "conclusion", "title": "Clinical Conclusions & Practice Implications", "column_hint": 2, "style": "focal_callout_subtle", "essential": true},
    {"id": "references_funding", "title": "References, Registration & Disclosures", "column_hint": 2, "style": "colophon", "essential": false}
  ]
}
