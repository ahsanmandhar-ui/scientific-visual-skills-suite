    {"id": "secondary_figure", "title": "Validation & Dose/Model Performance", "column_hint": 1, "style": "figure_well", "essential": false},
    {"id": "limitations", "title": "Reproducibility Controls & Limitations", "column_hint": 2, "style": "editorial_rule", "essential": true},
    {"id": "conclusion", "title": "Mechanistic & Translational Conclusions", "column_hint": 2, "style": "focal_callout_subtle", "essential": true},
